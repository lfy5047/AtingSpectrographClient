/* ── AtingSpectrograph Industrial Theme ── */

* {
    font-family: "Microsoft YaHei UI", sans-serif;
    font-size: 10pt;
    color: #E6E9EE;
}

QMainWindow, QDialog {
    background-color: #1F242B;
}

QWidget {
    background-color: transparent;
}

/* ── Sidebar ── */
QListWidget#sidebar {
    background-color: #1A1E24;
    border: none;
    border-right: 1px solid #3B424C;
    outline: none;
}
QListWidget#sidebar::item {
    padding: 11px 0 11px 20px;
    border-left: 3px solid transparent;
    color: #9AA3AD;
}
QListWidget#sidebar::item:selected {
    background-color: #21272F;
    border-left: 3px solid #00A3B4;
    color: #E6E9EE;
}
QListWidget#sidebar::item:hover:!selected {
    background-color: #252B33;
    color: #C9D1D9;
}

/* ── Panel title bar ── */
QLabel#panelTitle {
    font-size: 12pt;
    font-weight: bold;
    color: #E6E9EE;
    padding: 10px 14px 8px 14px;
    border-bottom: 1px solid #3B424C;
    background-color: #252A31;
}

/* ── GroupBox ── */
QGroupBox {
    background-color: #2A2F37;
    border: 1px solid #3B424C;
    border-radius: 4px;
    margin-top: 20px;
    padding: 12px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 6px;
    color: #00A3B4;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* ── Buttons ── */
QPushButton {
    background-color: #2A2F37;
    border: 1px solid #3B424C;
    border-radius: 2px;
    padding: 4px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #353B44;
    border-color: #00A3B4;
}
QPushButton:pressed {
    background-color: #00A3B4;
    color: #1F242B;
}
QPushButton:disabled {
    color: #555D67;
    border-color: #2A2F37;
}
QPushButton:focus {
    outline: none;
}
QPushButton[primary="true"] {
    background-color: #00A3B4;
    color: #1F242B;
    font-weight: bold;
}
QPushButton[primary="true"]:hover {
    background-color: #00BCD1;
}
QPushButton[primary="true"]:disabled {
    background-color: #1A4F56;
    color: #4A7A82;
}
QPushButton[danger="true"] {
    border-color: #E5484D;
    color: #E5484D;
}
QPushButton[danger="true"]:hover {
    background-color: #E5484D;
    color: #1F242B;
}

/* ── Input fields ── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1F242B;
    border: 1px solid #3B424C;
    border-radius: 2px;
    padding: 3px 6px;
    min-height: 18px;
    selection-background-color: #00A3B4;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: #00A3B4;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #555D67;
    background-color: #252A31;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #2A2F37;
    border: 1px solid #3B424C;
    selection-background-color: #00A3B4;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    height: 4px;
    background: #3B424C;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #00A3B4;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: #00A3B4;
    border-radius: 2px;
}

/* ── CheckBox ── */
QCheckBox {
    spacing: 6px;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #3B424C;
    border-radius: 2px;
    background-color: #1F242B;
}
QCheckBox::indicator:checked {
    background-color: #00A3B4;
    border-color: #00A3B4;
}

/* ── TabWidget ── */
QTabWidget::pane {
    border: 1px solid #3B424C;
    background-color: #2A2F37;
}
QTabBar::tab {
    background-color: #1F242B;
    border: 1px solid #3B424C;
    border-bottom: none;
    padding: 5px 16px;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background-color: #2A2F37;
    border-bottom: 2px solid #00A3B4;
    color: #00A3B4;
}
QTabBar::tab:hover:!selected {
    background-color: #353B44;
}

/* ── ScrollBar ── */
QScrollBar:vertical {
    background: #1F242B;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #3B424C;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #555D67;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}
QScrollBar:horizontal {
    background: #1F242B;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #3B424C;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
    width: 0;
}

/* ── PlainTextEdit (log) ── */
QPlainTextEdit {
    background-color: #1A1E24;
    border: 1px solid #3B424C;
    font-family: Consolas, monospace;
    font-size: 9pt;
    selection-background-color: #00A3B4;
}

/* ── Splitter ── */
QSplitter::handle {
    background-color: #3B424C;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:horizontal:hover {
    background-color: #00A3B4;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* ── Label ── */
QLabel {
    color: #E6E9EE;
}
QLabel[secondary="true"] {
    color: #9AA3AD;
}
QLabel[heading="true"] {
    font-size: 11pt;
    font-weight: bold;
    color: #00A3B4;
}
QLabel[readout="true"] {
    font-family: Consolas, monospace;
    font-size: 14pt;
    font-weight: bold;
    color: #E6E9EE;
}

/* ── Dynamic state colors ── */
QLabel[connState="ok"]  { color: #3FB950; }
QLabel[connState="err"] { color: #E5484D; }
QLabel[moving="true"]   { color: #E9B949; }
QLabel[moving="false"]  { color: #3FB950; }

/* ── Status bar ── */
QStatusBar {
    background-color: #1A1E24;
    border-top: 1px solid #3B424C;
    font-size: 9pt;
}
QStatusBar::item {
    border: none;
}
QFrame#statusSep {
    color: #3B424C;
}

/* ── ToolTip ── */
QToolTip {
    background-color: #2A2F37;
    border: 1px solid #3B424C;
    color: #E6E9EE;
    padding: 4px;
}

/* ── ScrollArea ── */
QScrollArea {
    border: none;
}
