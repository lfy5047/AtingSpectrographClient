/* AtingSpectrograph Client - Outdoor Light Theme */

/* ===== Global ===== */
* {
    font-family: "Microsoft YaHei UI", sans-serif;
    font-size: 10pt;
    color: #1F2937;
}

QMainWindow {
    background-color: #F3F6FA;
}

QWidget#mainCentral,
QWidget#mainContent {
    background-color: #F3F6FA;
}

QWidget {
    background-color: transparent;
}

QDialog {
    background-color: #F3F6FA;
}

QDialog#recordsDialog,
QDialog#spectrumCurveDialog {
    background-color: #F3F6FA;
}

QLabel#spectrumCurveStatus {
    color: #4B5563;
    font-weight: bold;
}

QCustomPlot#spectrumCurvePlot {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E2;
}

/* ===== Sidebar ===== */
QWidget#sidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #C9D4E2;
}

QWidget#sidebarLogo {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #C9D4E2;
}

QWidget#sidebarNav {
    background-color: #FFFFFF;
}

QLabel#sidebarLogoIcon {
    font-size: 14pt;
    font-weight: bold;
    color: #0B68D8;
}

QLabel#sidebarLogoText {
    font-size: 12pt;
    font-weight: bold;
    color: #111827;
}

QPushButton#navItem {
    text-align: left;
    padding: 9px 12px;
    border: none;
    border-radius: 6px;
    color: #4B5563;
    font-size: 12pt;
    font-weight: normal;
    margin-bottom: 2px;
}

QPushButton#navItem:hover {
    background-color: #E7F1FF;
    color: #111827;
}

QPushButton#navItem[active="true"] {
    background-color: #DCEBFF;
    color: #0B68D8;
    border-left: 3px solid #0B68D8;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    margin-left: -4px;
    padding-left: 16px;
}

QWidget#sidebarFooter {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #C9D4E2;
}

QLabel#sidebarConnText {
    font-size: 10pt;
    color: #4B5563;
}

QPushButton#sidebarCollapseBtn {
    text-align: left;
    padding: 8px 12px;
    border: none;
    border-radius: 6px;
    color: #4B5563;
    font-size: 11pt;
}

QPushButton#sidebarCollapseBtn:hover {
    background-color: #E7F1FF;
    color: #111827;
}

/* ===== TopBar ===== */
QWidget#topbar {
    background-color: #F3F6FA;
    border: none;
    border-bottom: 1px solid #C9D4E2;
}

QFrame#metricCard,
QFrame#themeCard {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E2;
    border-radius: 10px;
    padding: 10px 14px;
}

QFrame#metricCard:hover,
QFrame#themeCard:hover {
    border-color: #8EA4C1;
}

QLabel#metricLabel {
    font-size: 10pt;
    color: #4B5563;
    font-weight: normal;
}

QLabel#metricValue {
    font-size: 11pt;
    font-weight: bold;
    color: #111827;
}

QLabel#metricSub {
    font-size: 9pt;
    color: #667085;
}

QLabel#metricValueConn {
    font-size: 14pt;
    font-weight: bold;
}

/* ===== Panel Area ===== */
QWidget#panelContainer {
    background-color: #FFFFFF;
    border: none;
    border-left: 1px solid #C9D4E2;
}

QLabel#panelTitle {
    font-size: 13pt;
    font-weight: bold;
    color: #111827;
    padding: 14px 16px 10px 16px;
    border-bottom: 1px solid #C9D4E2;
    background-color: #FFFFFF;
}

QStackedWidget#panelStack {
    background-color: #FFFFFF;
}

/* ===== Card ===== */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E2;
    border-radius: 10px;
    padding: 14px;
    margin: 4px 0;
}

QLabel#cardHeader {
    font-size: 10pt;
    font-weight: bold;
    color: #4B5563;
    margin-bottom: 8px;
}

/* ===== GroupBox ===== */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E2;
    border-radius: 10px;
    margin-top: 18px;
    padding: 16px 12px 12px 12px;
    font-size: 10pt;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #374151;
}

/* ===== Buttons ===== */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #B8C6D8;
    border-radius: 5px;
    padding: 6px 14px;
    min-height: 22px;
    color: #1F2937;
    font-size: 11pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #E7F1FF;
    color: #0B68D8;
    border-color: #0B68D8;
}

QPushButton:focus {
    outline: none;
    border-color: #0B68D8;
}

QPushButton:disabled {
    color: #9AA6B2;
    border-color: #D8E0EA;
    background-color: #F4F7FB;
}

QPushButton[primary="true"] {
    background-color: #0B68D8;
    color: #FFFFFF;
    border-color: #0B68D8;
}

QPushButton[primary="true"]:hover {
    background-color: #0759BA;
    border-color: #0759BA;
    color: #FFFFFF;
}

QPushButton[primary="true"]:disabled {
    background-color: #BFD6F5;
    color: #FFFFFF;
    border-color: #BFD6F5;
}

QPushButton[danger="true"] {
    border-color: #C73434;
    color: #B42318;
    background-color: #FFFFFF;
}

QPushButton[danger="true"]:hover {
    background-color: #FDECEC;
}

QPushButton[ghost="true"] {
    background-color: transparent;
    border: none;
    color: #4B5563;
    padding: 4px 8px;
}

QPushButton[ghost="true"]:hover {
    background-color: #E7F1FF;
    color: #0B68D8;
}

QPushButton[small="true"] {
    padding: 3px 8px;
    font-size: 10pt;
    min-height: 18px;
    border-radius: 4px;
}

/* ===== Input fields ===== */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #B8C6D8;
    border-radius: 5px;
    padding: 6px 9px;
    min-height: 20px;
    color: #111827;
    selection-background-color: #0B68D8;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0B68D8;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: #9AA6B2;
    background-color: #F4F7FB;
    border-color: #D8E0EA;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #B8C6D8;
    border-radius: 5px;
    padding: 5px 9px;
    min-height: 20px;
    color: #111827;
}

QComboBox:focus {
    border-color: #0B68D8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #B8C6D8;
    selection-background-color: #DCEBFF;
    selection-color: #0B68D8;
    color: #111827;
    outline: none;
}

/* ===== Slider ===== */
QSlider::groove:horizontal {
    height: 4px;
    background: #D8E0EA;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0B68D8;
    width: 15px;
    height: 15px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #0B68D8;
    border-radius: 2px;
}

/* ===== CheckBox ===== */
QCheckBox {
    spacing: 8px;
    color: #1F2937;
    font-size: 11pt;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1.5px solid #8EA4C1;
    border-radius: 3px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #0B68D8;
    border-color: #0B68D8;
}

/* ===== TabWidget ===== */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabWidget#imageTabs::pane {
    border: none;
    background-color: #101820;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    padding: 6px 14px;
    margin: 0;
    color: #4B5563;
    font-size: 11pt;
    font-weight: bold;
}

QTabBar::tab:selected {
    color: #FFFFFF;
    background-color: #0B68D8;
    border-radius: 5px;
}

QTabBar::tab:hover:!selected {
    color: #0B68D8;
}

QTabWidget#panelSubTabs::pane {
    border: none;
    background-color: transparent;
    top: -1px;
}

QTabWidget#panelSubTabs QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 12px;
    color: #4B5563;
    font-size: 11pt;
    font-weight: bold;
    margin-bottom: -1px;
}

QTabWidget#panelSubTabs QTabBar::tab:selected {
    background-color: transparent;
    color: #0B68D8;
    border-bottom: 2px solid #0B68D8;
    border-radius: 0;
}

QTabWidget#panelSubTabs QTabBar::tab:hover:!selected {
    color: #0B68D8;
    background-color: transparent;
}

/* ===== Log Panel ===== */
QWidget#logPanel {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #C9D4E2;
}

QWidget#logPanelHeader {
    background-color: #FFFFFF;
    border: none;
}

QWidget#logPanelHeader:hover {
    background-color: #E7F1FF;
}

QLabel#logPanelTitle {
    font-size: 10pt;
    font-weight: bold;
    color: #4B5563;
}

QPushButton#logFilterTag {
    background-color: #FFFFFF;
    border: 1px solid #B8C6D8;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 9pt;
    color: #4B5563;
    min-height: 18px;
    font-weight: normal;
}

QPushButton#logFilterTag:hover {
    border-color: #0B68D8;
}

QPushButton#logFilterTag[active="true"] {
    background-color: #DCEBFF;
    color: #0B68D8;
    border-color: #0B68D8;
}

QLabel#logBadge {
    font-size: 9pt;
    font-weight: bold;
    padding: 1px 6px;
    border-radius: 10px;
}

QPlainTextEdit#logView {
    background-color: #FFFFFF;
    border: none;
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 10pt;
    color: #374151;
    selection-background-color: #0B68D8;
    selection-color: #FFFFFF;
}

/* ===== ScrollArea ===== */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollArea#panelScroll > QWidget {
    background-color: #FFFFFF;
}

/* ===== ScrollBar ===== */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #B8C6D8;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #8EA4C1;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 7px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #B8C6D8;
    border-radius: 3px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #8EA4C1;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ===== TableWidget ===== */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E2;
    border-radius: 6px;
    gridline-color: #D8E0EA;
    color: #111827;
    selection-background-color: #DCEBFF;
    selection-color: #0B68D8;
    outline: none;
}

QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #DCEBFF;
    color: #0B68D8;
}

QTableWidget::item:alternate {
    background-color: #F4F7FB;
}

QHeaderView::section {
    background-color: #EEF3F9;
    color: #374151;
    border: none;
    border-bottom: 1px solid #C9D4E2;
    border-right: 1px solid #C9D4E2;
    padding: 5px 8px;
    font-size: 10pt;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #DCEBFF;
    color: #0B68D8;
}

QTableCornerButton::section {
    background-color: #EEF3F9;
    border: none;
    border-bottom: 1px solid #C9D4E2;
    border-right: 1px solid #C9D4E2;
}

/* ===== Splitter ===== */
QSplitter::handle {
    background-color: #C9D4E2;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:horizontal:hover {
    background-color: #0B68D8;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ===== Labels ===== */
QLabel {
    color: #1F2937;
}

QLabel[secondary="true"] {
    color: #4B5563;
}

QLabel[tertiary="true"] {
    color: #667085;
}

QLabel[readout="true"] {
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 14pt;
    font-weight: bold;
    color: #111827;
}

QLabel[readoutSm="true"] {
    font-family: "Cascadia Code", "Fira Code", "Consolas", monospace;
    font-size: 11pt;
    font-weight: bold;
    color: #111827;
}

QLabel[connOk="true"],
QLabel[connState="ok"],
QLabel[moving="false"] {
    color: #137333;
    font-weight: bold;
}

QLabel[connErr="true"] {
    color: #667085;
}

QLabel[connState="err"] {
    color: #B42318;
    font-weight: bold;
}

QLabel[moving="true"] {
    color: #A15C00;
}

/* ===== Status badges ===== */
QLabel[badge="ok"] {
    color: #137333;
    background-color: #E7F6EC;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10pt;
    font-weight: bold;
}

QLabel[badge="err"] {
    color: #B42318;
    background-color: #FDECEC;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10pt;
    font-weight: bold;
}

QLabel[badge="warn"] {
    color: #A15C00;
    background-color: #FFF4D6;
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10pt;
    font-weight: bold;
}

/* ===== Image Viewer ===== */
QWidget#viewerContainer,
QStackedWidget#viewerStack,
QWidget#imageView {
    background-color: #F3F6FA;
}

QWidget#viewerOverlay {
    background-color: rgba(18, 23, 29, 0);
}

QWidget#channelTabBar {
    background-color: #F3F6FA;
}

QWidget#imageStatsOverlay {
    background-color: rgba(255, 255, 255, 235);
    border: 1px solid rgba(55, 126, 216, 160);
    border-radius: 8px;
}

QWidget#spectralProgressOverlay {
    background-color: rgba(10, 14, 20, 225);
    border: 1px solid rgba(55, 126, 216, 170);
    border-radius: 8px;
}

QPushButton#channelTab {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 11pt;
    font-weight: bold;
    color: #4B5563;
}

QPushButton#channelTab[active="true"] {
    background-color: #0B68D8;
    color: #FFFFFF;
}

QPushButton#channelTab:hover:!active {
    background-color: #E7F1FF;
    color: #0B68D8;
}

QPushButton#toolBtn {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    padding: 6px;
    min-height: 24px;
    min-width: 24px;
    color: #4B5563;
}

QPushButton#toolBtn:hover {
    background-color: #E7F1FF;
    color: #0B68D8;
}

QLabel#zoomLabel {
    font-size: 10pt;
    color: #4B5563;
    font-weight: bold;
}

QLabel#imgInfoLabel {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9pt;
    color: #111827;
    font-weight: 600;
}

QLabel#spectralProgressLabel {
    font-size: 10pt;
    color: #EAF2FF;
    font-weight: bold;
}

QProgressBar#spectralProgressBar {
    background-color: #17202A;
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    min-height: 10px;
    max-height: 10px;
}

QProgressBar#spectralProgressBar::chunk {
    background-color: #2F8CFF;
    border-radius: 3px;
}

/* ===== ToolTip ===== */
QToolTip {
    background-color: #111827;
    border: 1px solid #334155;
    color: #FFFFFF;
    padding: 4px 8px;
    font-size: 10pt;
}

/* ===== Dashboard ===== */
QLabel#dashStatKey {
    font-size: 11pt;
    color: #4B5563;
}

QLabel#dashStatVal {
    font-size: 11pt;
    font-weight: bold;
    color: #111827;
}

/* ===== Conn dot ===== */
QLabel#connDot {
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}
