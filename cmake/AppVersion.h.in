#pragma once

#include <QString>

namespace AppVersion {

inline const char* organizationName()
{
    return "AtingSpectrograph";
}

inline const char* applicationName()
{
    return "@PROJECT_NAME@";
}

inline const char* version()
{
    return "@APP_VERSION_DISPLAY@";
}

inline const char* baseVersion()
{
    return "@APP_VERSION_BASE@";
}

inline int versionMajor()
{
    return @APP_VERSION_MAJOR@;
}

inline int versionMinor()
{
    return @APP_VERSION_MINOR@;
}

inline int versionPatch()
{
    return @APP_VERSION_PATCH@;
}

inline QString windowTitle()
{
    return QString::fromUtf8("AtingSpectrograph Client - Spectra Pro v%1")
        .arg(QString::fromLatin1(version()));
}

} // namespace AppVersion
